# Copy to .env and adjust. Nothing here is required for Milestone 1.

# Where Stanza keeps its downloaded UD models.
SPLM_STANZA_DIR=./data/raw/stanza_resources

# Where Hugging Face caches base LLM weights.
HF_HOME=./data/raw/hf

# Override the base LLM without editing config/model.yaml.
# SPLM_MODEL_ID=HuggingFaceTB/SmolLM2-135M

# Force a device: cpu | cuda | auto
# SPLM_DEVICE=auto

# Logging: DEBUG | INFO | WARNING | ERROR
SPLM_LOG_LEVEL=INFO
