# Copy to .env and adjust. Nothing here is required for Milestone 1.

# Where Stanza keeps its downloaded UD models.
SPLM_STANZA_DIR=./data/raw/stanza_resources

# Where Hugging Face caches base LLM weights.
HF_HOME=./data/raw/hf

# Override the base LLM without editing config/model.yaml.
# SPLM_MODEL_ID=HuggingFaceTB/SmolLM2-135M

# Force a device: cpu | cuda | auto
# SPLM_DEVICE=auto

# Runtime installer: cpu (small default) or cuda. For a specific CUDA build, also
# set the index URL generated by https://pytorch.org/get-started/locally/.
SPLM_TORCH_MODE=cpu
# SPLM_TORCH_INDEX_URL=<copy the matching URL from the PyTorch installer selector>

# Large Wiktionary dumps are disabled by the launchers unless explicitly enabled.
SPLM_LEXICON_AUTO_DOWNLOAD=false

# Logging: DEBUG | INFO | WARNING | ERROR
SPLM_LOG_LEVEL=INFO
